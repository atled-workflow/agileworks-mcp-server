    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@modelcontextprotocol/inspector": "0.19.0",
        "@types/express": "4.17.25",
        "@types/node": "24.10.9",
        "orval": "7.21.0",
        "tsdown": "0.11.13",
        "tsx": "4.19.4",
        "typescript": "5.8.3",
        "yaml": "2.8.4"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "3.1080.0",
        "@aws-sdk/lib-dynamodb": "3.1080.0",
        "@modelcontextprotocol/sdk": "1.29.0",
        "dotenv": "17.2.1",
        "express": "4.21.0",
        "http-status-codes": "2.3.0",
        "zod": "3.25.67"
    }
