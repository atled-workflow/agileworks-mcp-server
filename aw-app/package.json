{
    "name": "orval-agileworks-mcp",
    "version": "0.3.1",
    "main": "index.js",
    "engines": {
        "node": ">=24.13.0 <25.0.0"
    },
    "scripts": {
        "start:admin": "node ./dist/custom/admin/server.js",
        "start:admin-http": "node ./dist/custom/admin/server-http.js",
        "inspect:admin": "npx @modelcontextprotocol/inspector node ./dist/custom/admin/server.js",
        "dev:admin": "tsx ./src/custom/admin/server.ts",
        "dev:admin-http": "tsx ./src/custom/admin/server-http.ts",
        "build": "orval && tsx src/custom/scripts/generate-register-tools.ts && tsx src/custom/scripts/fix-handlers-imports.ts",
        "tsdown:build": "tsdown",
        "test": "tsx --test src/custom/__tests__/**/*.test.ts"
    },
    "keywords": [],
