# リモートMCPサーバー（Docker）用の設定例です。
# このファイルをコピーして .env を作成し、値を書き換えてください。
#   cp .env.example .env

# MCPサーバーの待ち受けポート
MCP_PORT=8002

# 外部から見たMCPサーバーのURL（必須）
# https で始まり、パスと末尾のスラッシュを含めない形式で記載してください
MCP_SERVER_BASE_URL=https://mcp.example.co.jp

# （任意）CORS の Access-Control-Allow-Origin（未設定の場合は *）
# CORS_ALLOW_ORIGIN=*
